# Dada Advisory - Environment Variables
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Database Configuration
# Local SQLite for zero-config portable execution:
DATABASE_URL="file:./dev.db"
# Or PostgreSQL for production:
# DATABASE_URL="postgresql://user:password@localhost:5432/dada_advisory?schema=public"

# Authentication & Security
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_EXPIRES_IN=7d

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001

# NBFC Partner Integrations (Mocked for Demo)
APEX_NBFC_WEBHOOK_SECRET=apex_webhook_mock_secret_key_2026
DMI_NBFC_WEBHOOK_SECRET=dmi_webhook_mock_secret_key_2026

# Storage Abstraction
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
